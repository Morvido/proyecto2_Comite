@startuml
title Proyecto 2 / Comité Olímpico de Guatemala

class App {
  +main(args: String[]): void
}

class Menu {
  - registroService: RegistroService
  - analisisService: AnalisisService
  - csvService: CSVService
  - dbService: DBService
  - jsonService: JSONService
  - gestionFinanciera: GestionFinanciera
  - scanner: Scanner
  +iniciar(): void
  +registrarAtleta(): void
  +registrarEntrenamiento(): void
  +buscarAtletaPorNombre(): void
  +buscarAtletasPorDisciplina(): void
  +guardarCSV(): void
  +cargarCSV(): void
}

class RegistroService {
  - registros: Map<Atleta, List<Entrenamiento>>
  +registrarAtleta(atleta: Atleta): void
  +registrarEntrenamiento(atleta: Atleta, entrenamiento: Entrenamiento): void
  +buscarAtletaPorNombre(nombre: String, apellido: String): Atleta
  +buscarAtletasPorDisciplina(disciplina: String): List<Atleta>
  +getRegistros(): Map<Atleta, List<Entrenamiento>>
}

class AnalisisService {
  +calcularPromedio(entrenamientos: List<Entrenamiento>): double
  +mejorMarca(entrenamientos: List<Entrenamiento>): Entrenamiento
  +evolucion(entrenamientos: List<Entrenamiento>): List<Entrenamiento>
}

class CSVService {
  +guardar(archivo: String, registros: Map<Atleta, List<Entrenamiento>>): void
  +cargar(archivo: String): Map<Atleta, List<Entrenamiento>>
}

class DBService {
  +guardar(atletas: List<Atleta>, entrenamientos: List<Entrenamiento>, pagos: List<Pagos>): void
  +cargar(): void
}

class JSONService {
  +guardar(archivo: String, atletas: List<Atleta>, entrenamientos: List<Entrenamiento>): void
  +cargar(archivo: String): void
}

class Atleta {
  - nombre: String
  - apellido: String
  - edad: int
  - disciplina: Disciplina
  - nacionalidad: String
  - departamento: String
  - fechaIngreso: LocalDate
  +getNombre(): String
  +getApellido(): String
  +getEdad(): int
  +getDisciplina(): Disciplina
}

class Entrenamiento {
  - fecha: LocalDate
  - tipo: String
  - valor: double
  +getFecha(): LocalDate
  +getTipo(): String
  +getValor(): double
}

class Pagos {
  - monto: double
  - fecha: LocalDate
  +realizarPago(monto: double): void
  +getHistorial(): List<Pagos>
}

class GestionFinanciera {
  +gestionarPagos(atleta: Atleta, pago: Pagos): void
  +verHistorial(atleta: Atleta): List<Pagos>
}

abstract class Disciplina {
  - nombre: String
  +getNombre(): String
  +getTipoMedida(): String
}

class Carrera
class Marcha
class LevantamientoPesas
class Natacion
class Ciclismo
class Boxeo
class Gimnasia
class Judo
class Futbol
class Baloncesto

' Relaciones
App --> Menu
Menu --> RegistroService
Menu --> AnalisisService
Menu --> CSVService
Menu --> DBService
Menu --> JSONService
Menu --> GestionFinanciera

RegistroService --> Atleta
RegistroService --> Entrenamiento
AnalisisService --> Entrenamiento
CSVService --> RegistroService
JSONService --> RegistroService
DBService --> RegistroService
GestionFinanciera --> Pagos
Atleta --> Disciplina

Disciplina <|-- Carrera
Disciplina <|-- Marcha
Disciplina <|-- LevantamientoPesas
Disciplina <|-- Natacion
Disciplina <|-- Ciclismo
Disciplina <|-- Boxeo
Disciplina <|-- Gimnasia
Disciplina <|-- Judo
Disciplina <|-- Futbol
Disciplina <|-- Baloncesto

@enduml
